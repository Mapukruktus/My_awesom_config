font-family = "Fira Code"
font-size = 16
theme = Nord

# window
window-decoration = false
window-width = 999
window-height = 999
window-padding-x = 8
window-padding-y = 4

cursor-style = block 
cursor-style-blink = false

# background
background-opacity = 1

# performance
mouse-hide-while-typing = true
confirm-close-surface = false
